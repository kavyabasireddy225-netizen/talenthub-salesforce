<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_Apply_To_Closed_Position</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(),
    OR(ISPICKVAL(Position__r.Status__c, &quot;Closed&quot;),
       ISPICKVAL(Position__r.Status__c, &quot;Filled&quot;)))</errorConditionFormula>
    <errorMessage>You cannot apply to a position that is Closed or Filled.</errorMessage>
</ValidationRule>
