<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Offer_Amount_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, &quot;Offer Extended&quot;), ISBLANK(Offer_Amount__c))</errorConditionFormula>
    <errorDisplayField>Offer_Amount__c</errorDisplayField>
    <errorMessage>Please enter an Offer Amount when Status is Offer Extended.</errorMessage>
</ValidationRule>
